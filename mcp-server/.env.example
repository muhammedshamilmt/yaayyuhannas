# Server Port
PORT=3001

# MongoDB Connection String (from Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Database Name
MONGODB_DB=wattaqa-festival-2k25

# Secret Auth Token for AI Clients (leave empty for open local development)
# Generate a secure key: openssl rand -hex 32
MCP_AUTH_TOKEN=your-super-secret-mcp-token-here

# Read-Only Safety Switch (true/false)
READ_ONLY=true

# Maximum document limit returned in a single query
MAX_DOCUMENTS_LIMIT=100
